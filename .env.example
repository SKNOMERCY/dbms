# Copy this file to .env and replace the placeholder before running the app.
PGHOST=localhost
PGPORT=5432
PGDATABASE=finguard
PGUSER=postgres
PGPASSWORD=replace_with_your_local_postgres_password

# Optional: point PostgreSQL integration tests at a disposable test database.
# TEST_DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/finguard_test
